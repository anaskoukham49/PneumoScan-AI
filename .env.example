# Copy this file to .env and fill in your keys
# cp .env.example .env

# — Google Gemini — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# — Database — SQLite by default, Postgres for production
DATABASE_URL=sqlite:///./pneumoscan.db
# DATABASE_URL=postgresql://user:password@localhost:5432/pneumoscan
